# VidMind Environment Configuration Example

# System Settings
ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=change-this-in-production-secret-key-32-bytes

# AI Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (PostgreSQL in Production)
DATABASE_URL=sqlite:///./vidmind.db

# Storage Directories
ARTIFACTS_DIR=../artifacts
